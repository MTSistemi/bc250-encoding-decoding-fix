[Unit]
Description=Redirect the system radeonsi VA-API driver slot to bc250_drv_video.so
Documentation=file:///etc/bc250-vaapi-redirect-apply.sh
DefaultDependencies=no
Before=sysinit.target sddm.service
After=local-fs.target

[Service]
# /usr on this ostree system is a fresh, read-only overlay every boot, so
# both the usroverlay (to get a writable /usr at all) and the symlink swap
# itself have to be redone here on every single boot - neither survives
# from the previous one. See docs/DEVLOG.md ("boot persistence") for why
# this can't just be a one-time fix.
Type=oneshot
RemainAfterExit=yes
# usroverlay fails loudly (nonzero exit) if /usr is already unlocked -
# expected and harmless if this unit ever runs twice in one boot, or if
# something else already unlocked it. The "-" tells systemd not to treat
# that as a failure of this unit.
ExecStart=-/usr/bin/rpm-ostree usroverlay
# The actual driver location varies by which installer was used
# (build_and_install.sh / setup_bazzite.sh / setup_steamos.sh each pick a
# different directory) - this script searches for it rather than assuming
# one path. It lives in /etc, not /usr, because /etc survives the ostree
# /usr-overlay reset above and /usr does not.
ExecStart=/etc/bc250-vaapi-redirect-apply.sh

[Install]
WantedBy=sysinit.target
